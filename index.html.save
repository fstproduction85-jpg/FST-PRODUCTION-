<!DOCTYPE htm l
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FST PRODUCTION — Ta musique locale</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #17120c;
    --card: #241b12cc;
    --card-hover: #2c2117;
    --amber: #e2841f;
    --amber-deep: #b85f10;
    --text: #f3ead9;
    --muted: #a08a70;
    --line: #33291b;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{ height:100%; }
  body{
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    max-width: 480px;
    margin: 0 auto;
    min-height: 100vh;
    display:flex;
    flex-direction:column;
    padding-bottom: 84px;
    position: relative;
    overflow-x: hidden;
    background-image:
      linear-gradient(rgba(23,18,12,.86), rgba(23,18,12,.92)),
      url('background.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }
  .watermark{
    position: fixed;
    inset: 0;
    max-width: 480px;
    margin: 0 auto;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }
  .watermark span{
    position: absolute;
    white-space: nowrap;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: var(--text);
    opacity: 0.045;
    transform: rotate(-28deg);
  }
  header, main, .player{ position: relative; z-index: 2; }
  header{
    padding: 28px 20px 18px;
    border-bottom: 1px solid var(--line);
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:12px;
  }
  header h1{
    font-family: 'Space Grotesk', sans-serif;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  header p{
    color: va(--muted);
    font-size: 13px;
    margin-top: 4px;
  }
  header a.help{
    color: var(--muted);
    text-decoration:none;
    font-size:20px;
    padding-top:2px;
  }
  main{
    flex: 1;
    padding: 18px 20px 20px;
  }
  .section-title{
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 700;
    margin: 22px 0 12px;
  }
  .section-title:first-child{ margin-top: 0; }
  .scroll-row{
    display:flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
  }
  .scroll-row::-webkit-scrollbar{ display:none; }
  .track-card{
    flex: 0 0 auto;
    width: 140px;
    background: var(--card);
    backdrop-filter: blur(2px);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    transition: background .15s ease;
  }
  .track-card:active{ background: var(--card-hover); }
  .cover{
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(135deg, var(--amber-deep), var(--amber));
    background-size: cover;
    background-position: center;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'Space Grotesk', sans-serif;
    font-weight:700;
    font-size: 26px;
    color: rgba(23,18,12,.85);
  }
  .track-info{ padding: 10px 10px 12px; }
  .track-title{ font-size: 13px; font-weight: 600; line-height:1.3; }
  .track-artist{ font-size: 12px; color: var(--muted); margin-top: 2px; }
  .track-list{
    display:flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .track-row{
    display:flex;
    align-items:center;
    gap: 12px;
    padding: 10px 12px;
    background: var(--card);
    backdrop-filter: blur(2px);
    border-bottom: 1px solid var(--line);
    cursor: pointer;
  }
  .track-row:last-child{ border-bottom: none; }
  .track-row:active{ background: var(--card-hover); }
  .track-row .mini-cover{
    width: 40px; height: 40px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--amber-deep), var(--amber));
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
  }
  .track-row .meta{ flex: 1; min-width: 0; }
  .track-row .track-title{ font-size: 13.5px; }
  .track-row .track-artist{ font-size: 12px; }
  .track-row .duration{
    font-size: 12px;
    color: var(--muted);
    flex-shrink: 0;
  }
  .track-row.playing .track-title{ color: var(--amber); }
  .player{
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 480px;
    background: #241b12f0;
    backdrop-filter: blur(6px);
    border-top: 1px solid var(--line);
    padding: 10px 14px 14px;
  }
  .player-top{
    display:flex;
    align-items:center;
    gap: 10px;
  }
  .player .mini-cover{
    width: 38px; height: 38px;
    border-radius: 7px;
    background: linear-gradient(135deg, var(--amber-deep), var(--amber));
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
  }
  .player-meta{ flex:1; min-width:0; }
  .player-meta .title{ font-size: 13px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .player-meta .artist{ font-size: 11.5px; color: var(--muted); }
  .player-controls{ display:flex; align-items:center; gap: 6px; }
  .player-controls button{
    background: none;
    border: none;
    color: var(--text);
    font-size: 18px;
    padding: 6px;
    cursor: pointer;
    line-height: 1;
  }
  .player-controls .play-btn{
    background: var(--amber);
    color: #17120c;
    width: 34px; height: 34px;
    border-radius: 50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size: 15px;
  }
  .progress{
    margin-top: 10px;
    height: 3px;
    background: var(--line);
    border-radius: 2px;
    position: relative;
    cursor: pointer;
  }
  .progress-fill{
    height: 100%;
    width: 0%;
    background: var(--amber);
    border-radius: 2px;
  }
  #intro{
    position: fixed;
    inset: 0;
    background: #0e0b07;
    z-index: 100;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction: column;
    perspective: 900px;
    overflow: hidden;
    cursor: pointer;
    transition: opacity .6s ease;
  }
  #intro.hide{ opacity: 0; pointer-events: none; }
  .pour-stage{
    position: relative;
    width: 100%;
    height: 220px;
    display:flex;
    align-items:flex-end;
    justify-content:center;
    transform-style: preserve-3d;
  }
  .spout{
    position: absolute;
    top: 0;
    left: 50%;
    width: 14px;
    height: 60px;
    background: linear-gradient(var(--amber-deep), var(--amber));
    border-radius: 0 0 6px 6px;
    transform: translateX(-50%) rotateX(20deg);
    box-shadow: 0 0 14px rgba(226,132,31,.5);
  }
  .grain{
    position: absolute;
    top: 55px;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
    opacity: 0;
    animation: fallGrain 1.1s ease-in forwards;
  }
  @keyframes fallGrain{
    0%{ opacity: 0; transform: translate(-50%,0) scale(1); }
    10%{ opacity: 1; }
    85%{ opacity: 1; }
    100%{ opacity: 0; transform: translate(var(--dx,-50%), 130px) scale(.5); }
  }
  .intro-title{
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 30px;
    letter-spacing: 0.04em;
    color: var(--amber);
    text-shadow: 0 2px 18px rgba(226,132,31,.55);
    opacity: 0;
    transform: translateY(14px) rotateX(30deg);
    transform-style: preserve-3d;
    transition: opacity .8s ease, transform .8s ease;
    margin-top: 18px;
    text-align: center;
  }
  .intro-title.show{
    opacity: 1;
    transform: translateY(0) rotateX(0deg);
  }
  .intro-sub{
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--muted);
    opacity: 0;
    transition: opacity .8s ease .3s;
    text-align: center;
    padding: 0 24px;
  }
  .intro-sub.show{ opacity: 1; }
  .intro-tap{
    position:absolute;
    bottom: 26px;
    font-size: 11px;
    color: var(--muted);
    opacity: 0;
    animation: fadeInTap 1s ease 2.4s forwards;
  }
  @keyframes fadeInTap{ to{ opacity: .6; } }
</style>
</head>
<body>

<div class="watermark" id="watermark"></div>

<div id="intro">
  <div class="pour-stage">
    <div class="spout"></div>
    <div id="grains"></div>
  </div>
  <div class="intro-title" id="intro-title">FST PRODUCTION</div>
  <div class="intro-sub" id="intro-sub">Application entièrement développée par FRANCK YAMEOGO</div>
  <div class="intro-tap">Touche l'écran pour continuer</div>
</div>

<header>
  <div>
    <h1>FST PRODUCTION</h1>
    <p>Ta musique locale, tous les sons du terroir</p>
  </div>
  <a href="aide.html" class="help">?</a>
</header>

<main>
  <div class="section-title">Nouveautés</div>
  <div class="scroll-row" id="new-releases"></div>

  <div class="section-title">Tous les morceaux</div>
  <div class="track-list" id="track-list"></div>
</main>

<div class="player">
  <div class="player-top">
    <div class="mini-cover" id="player-cover"></div>
    <div class="player-meta">
      <div class="title" id="player-title">Sélectionne un morceau</div>
      <div class="artist" id="player-artist">—</div>
    </div>
    <div class="player-controls">
      <button id="prev-btn">⏮</button>
      <button class="play-btn" id="play-btn">▶</button>
      <button id="next-btn">⏭</button>
    </div>
  </div>
  <div class="progress" id="progress-bar">
    <div class="progress-fill" id="progress-fill"></div>
  </div>
</div>

<audio id="audio-player"></audio>

<script>
  const wm = document.getElementById('watermark');
  for (let y = -40; y < 900; y += 90) {
    for (let x = -60; x < 480; x += 200) {
      const s = document.createElement('span');
      s.textContent = 'FST PRODUCTION';
      s.style.top = y + 'px';
      s.style.left = x + 'px';
      wm.appendChild(s);
    }
  }

  const grainsEl = document.getElementById('grains');
  for (let i = 0; i < 26; i++) {
    const g = document.createElement('div');
    g.className = 'grain';
    g.style.setProperty('--dx', (Math.random() * 60 - 30) + 'px');
    g.style.animationDelay = (Math.random() * 0.9) + 's';
    g.style.left = (50 + (Math.random() * 20 - 10)) + '%';
    grainsEl.appendChild(g);
  }

  setTimeout(() => document.getElementById('intro-title').classList.add('show'), 900);
  setTimeout(() => document.getElementById('intro-sub').classList.add('show'), 1300);

  const introEl = document.getElementById('intro');
  function closeIntro(){ introEl.classList.add('hide'); }
  introEl.addEventListener('click', closeIntro);
  setTimeout(closeIntro, 4200);

  const AUDIO_FOLDER = "audio05";

  const tracks = [
    { title: "Kadi Yeri", artist: "Sana Fabrice", src: `${AUDIO_FOLDER}/1.mp3`, cover: "" },
    { title: "Nam Yiri", artist: "Awa Traoré", src: `${AUDIO_FOLDER}/2.mp3`, cover: "" },
    { title: "Koudougou By Night", artist: "DJ Somda", src: `${AUDIO_FOLDER}/3.mp3`, cover: "" },
    { title: "Faso Léré", artist: "Les Frères Kaboré", src: `${AUDIO_FOLDER}/4.mp3`, cover: "" },
    { title: "Sabou", artist: "Nathalie Bazié", src: `${AUDIO_FOLDER}/5.mp3`, cover: "" },
  ];

  const newReleasesEl = document.getElementById('new-releases');
  const trackListEl = document.getElementById('track-list');
  const playerTitle = document.getElementById('player-title');
  const playerArtist = document.getElementById('player-artist');
  const playerCover = document.getElementById('player-cover');
  const playBtn = document.getElementById('play-btn');
  const audio = document.getElementById('audio-player');
  const progressFill = document.getElementById('progress-fill');
  const progressBar = document.getElementById('progress-bar');

  let currentIndex = -1;

  function initial(str){ return str.trim().charAt(0).toUpperCase(); }

  tracks.forEach((t, i) => {
    const coverStyle = t.cover ? `style="background-image:url('${t.cover}')"` : '';

    const card = document.createElement('div');
    card.className = 'track-card';
    card.innerHTML = `
      <div class="cover" ${coverStyle}>${t.cover ? '' : initial(t.title)}</div>
      <div class="track-info">
        <div class="track-title">${t.title}</div>
        <div class="track-artist">${t.artist}</div>
      </div>`;
    card.addEventListener('click', () => selectTrack(i));
    newReleasesEl.appendChild(card);

    const row = document.createElement('div');
    row.className = 'track-row';
    row.innerHTML = `
      <div class="mini-cover" ${coverStyle}></div>
      <div class="meta">
        <div class="track-title">${t.title}</div>
        <div class="track-artist">${t.artist}</div>
      </div>
      <div class="duration">--:--</div>`;
    row.addEventListener('click', () => selectTrack(i));
    trackListEl.appendChild(row);
  });

  function selectTrack(i){
    currentIndex = i;
    const t = tracks[i];
    playerTitle.textContent = t.title;
    playerArtist.textContent = t.artist;
    playerCover.style.backgroundImage = t.cover ? `url('${t.cover}')` : '';
    audio.src = t.src;
    audio.play().catch(() => {});
    playBtn.textContent = '⏸';
    document.querySelectorAll('.track-row').forEach((r, idx) => {
      r.classList.toggle('playing', idx === i);
    });
  }

  playBtn.addEventListener('click', () => {
    if (currentIndex === -1) { selectTrack(0); return; }
    if (audio.paused) { audio.play(); playBtn.textContent = '⏸'; }
    else { audio.pause(); playBtn.textContent = '▶'; }
  });

  document.getElementById('prev-btn').addEventListener('click', () => {
    if (currentIndex > 0) selectTrack(currentIndex - 1);
  });
  document.getElementById('next-btn').addEventListener('click', () => {
    if (currentIndex < tracks.length - 1) selectTrack(currentIndex + 1);
  });

  audio.addEventListener('timeupdate', () => {
    if (!audio.duration) return;
    progressFill.style.width = (audio.currentTime / audio.duration * 100) + '%';
  });
  audio.addEventListener('ended', () => {
    if (currentIndex < tracks.length - 1) selectTrack(currentIndex + 1);
    else playBtn.textContent = '▶';
  });
  progressBar.addEventListener('click', (e) => {
    if (!audio.duration) return;
    const rect = progressBar.getBoundingClientRect();
    const ratio = (e.clientX - rect.left) / rect.width;
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FST PRODUCTION — Ta musique locale</title>
<link rel="preconnect" href="https
